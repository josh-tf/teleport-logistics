{
  "$meta": {
    "name": "Teleport Logistics native UI",
    "units": "logical design units (du) at 1.0 UI scale",
    "reference": "1920x1080",
    "runtime": "UE 5.6.1 Slate/UMG, base container Widget_Window_DarkMode"
  },
  "color": {
    "surface.window": "rgba(22,22,23,0.94)",
    "surface.titlebar": "linear-gradient(#3E3E3E,#313131)",
    "surface.titlebar.close": "#4A4A4A",
    "surface.plate": "linear-gradient(160deg,#484848,#343434 46%,#2B2B2B)",
    "surface.panel": "rgba(38,38,38,0.60)",
    "surface.row": "#333333",
    "surface.row.hover": "#3E3E3E",
    "surface.row.selected": "#3A2F22",
    "surface.input": "#141414",
    "surface.disabled": "#242424",
    "accent.orange": "#E8963C",
    "accent.orangeBright": "#F2A64A",
    "accent.orangePress": "#C97C28",
    "accent.focus": "#F6BD74",
    "accent.cyan": "#4FC3E8",
    "status.ok": "#7FC05F",
    "status.warn": "#E8C33C",
    "status.error": "#D1705E",
    "ink.primary": "#E8E8E8",
    "ink.strong": "#F0F0F0",
    "ink.dim": "#9C9C9C",
    "ink.mute": "#6E6E6E",
    "ink.onAccent": "#1A1207",
    "border.hairline": "rgba(0,0,0,0.45)",
    "border.control": "#4A4A4A",
    "bevel.light": "rgba(255,255,255,0.11)",
    "bevel.dark": "rgba(0,0,0,0.45)"
  },
  "font": {
    "family.ui": "Barlow",
    "family.condensed": "Barlow Condensed",
    "family.semiCondensed": "Barlow Semi Condensed",
    "windowTitle": {
      "size": 21,
      "line": 26,
      "weight": 500
    },
    "buildingId": {
      "family": "Barlow Condensed",
      "size": 17,
      "line": 21,
      "weight": 600,
      "tracking": 0.06,
      "case": "upper"
    },
    "groupLabel": {
      "family": "Barlow Semi Condensed",
      "size": 11,
      "line": 14,
      "weight": 600,
      "tracking": 0.16,
      "case": "upper"
    },
    "routeName": {
      "size": 22,
      "line": 26,
      "weight": 700
    },
    "rowPrimary": {
      "size": 16,
      "line": 21,
      "weight": 500
    },
    "body": {
      "size": 15,
      "line": 21,
      "weight": 400
    },
    "metric": {
      "size": 24,
      "line": 30,
      "weight": 600,
      "numeric": "tabular"
    },
    "meta": {
      "size": 12,
      "line": 17,
      "weight": 400
    },
    "minimum": {
      "size": 11,
      "note": "never scale type below this; reduce row count instead"
    }
  },
  "space": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 18,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "window": 0,
    "control": 2,
    "pill": 0
  },
  "border": {
    "hairline": 1,
    "focus": 2
  },
  "size": {
    "window.endpoint": {
      "w": 1320,
      "h": 760
    },
    "window.hub": {
      "w": 1560,
      "h": 880
    },
    "window.min": {
      "w": 1120,
      "h": 680
    },
    "titlebar.h": 56,
    "close": {
      "w": 66,
      "h": 56
    },
    "row.h": 42,
    "row.twoLine.h": 52,
    "directoryRow.h": 46,
    "scrollWell.maxH": 520,
    "hit.min": 44,
    "icon.title": 26,
    "icon.row": 15,
    "directory.columns": {
      "minWidth": 730,
      "endpoint": {
        "min": 150,
        "flex": 2.2
      },
      "routePath": {
        "min": 120,
        "flex": 1.7
      },
      "dir": 52,
      "medium": 104,
      "state": 78,
      "buffered": 92,
      "position": 120,
      "note": "every text cell carries a title tooltip with the full value"
    },
    "directory.share": {
      "flexBasis": 820,
      "wrapsFullWidthBelow": 1120
    }
  },
  "opacity": {
    "window": 0.94,
    "disabledRow": 0.55,
    "scrim": 0.72,
    "bevelLight": 0.11
  },
  "effect": {
    "windowBlur": 2,
    "windowShadow": "0 26 70 rgba(0,0,0,0.60)",
    "focusOutline": "2 #F6BD74 offset 2"
  },
  "nineSlice": {
    "plate": {
      "corner": 24,
      "stretch": "x+y",
      "screwInset": 6,
      "note": "screws inside corner quads"
    },
    "well": {
      "corner": 8,
      "stretch": "x+y"
    },
    "titlebar": {
      "corner": 0,
      "slices": "vertical 3-slice, 56 tall, 1 top highlight"
    }
  },
  "scaling": [
    {
      "resolution": "1920x1080",
      "uiScale": 1,
      "note": "reference capture"
    },
    {
      "resolution": "2560x1440",
      "uiScale": 1.25,
      "note": "window never exceeds 72% of shorter axis"
    },
    {
      "resolution": "3440x1440",
      "uiScale": 1.25,
      "note": "width capped at 1560 du, centred; no full-bleed stretch"
    }
  ]
}